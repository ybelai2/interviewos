# Server env example (server/.env)
# Server-only environment variables. DO NOT commit real secrets.
# Required in production: OPENAI_API_KEY, DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DATABASE_URL=
SERVER_PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_TIMEOUT_MS=20000
