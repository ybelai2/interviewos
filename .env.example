# InterviewOS local environment variables

# --- SERVER (server-only, never commit real secrets) ---
# OPENAI_API_KEY: Server-side OpenAI API key used to call the model for analysis. REQUIRED for AI analysis.
# OPENAI_MODEL: Model to use (e.g., gpt-4o). Default: gpt-4o
# DATABASE_URL: Postgres connection string (Supabase or other). REQUIRED in production.
# SERVER_PORT: Local server port (default 4000)
# SUPABASE_URL: Your Supabase project URL (used when uploading to Supabase Storage)
# SUPABASE_SERVICE_ROLE_KEY: Supabase service role key (server only). REQUIRED to upload to Supabase Storage in production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DATABASE_URL=
SERVER_PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- FRONTEND (public-safe) ---
# VITE_API_BASE_URL: URL for frontend to call backend server
# VITE_USE_MOCK_DATA: Set to "true" to explicitly enable seed/mock mode for local development
VITE_API_BASE_URL=http://localhost:4000
VITE_USE_MOCK_DATA=false
